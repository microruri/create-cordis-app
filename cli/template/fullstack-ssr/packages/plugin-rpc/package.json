{
  "name": "@acme/plugin-rpc",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rolldown -c ../../rolldown.config.ts --configLoader native"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./src/http.ts",
      "development": "./src/http.ts",
      "default": "./dist/http.js"
    },
    "./client": "./src/client.ts"
  },
  "dependencies": {
    "@cordisjs/plugin-server": "1.7.0",
    "@trpc/server": "11.19.0",
    "@trpc/client": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "@tanstack/react-query": "5.103.2",
    "react": "19.3.0",
    "cordis": "4.0.0-rc.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  }
}
