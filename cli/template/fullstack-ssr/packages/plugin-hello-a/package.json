{
  "name": "@acme/plugin-hello-a",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "rolldown -c ../../rolldown.config.ts --configLoader native"
  },
  "exports": {
    ".": {
      "types": "./src/server/index.ts",
