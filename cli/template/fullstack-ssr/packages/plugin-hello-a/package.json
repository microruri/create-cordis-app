    "cordis": "4.0.0-rc.10",
    "zod": "4.6.5"
  },
  "private": true,
  "devDependencies": {
    "@tanstack/react-query": "5.103.2",
    "react": "19.3.0",
    "@types/react": "19.3.0",
    "@acme/plugin-web": "workspace:*",
    "vike": "0.4.266",
    "vike-react": "0.6.27"
  }
