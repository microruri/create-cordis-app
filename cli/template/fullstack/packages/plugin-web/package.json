{
  "name": "@acme/plugin-web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rolldown -c ../../rolldown.config.ts --configLoader native"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./src/build.ts",
      "development": "./src/build.ts",
      "default": "./dist/build.js"
    },
    "./types": {
      "types": "./client/types.ts"
    }
  },
  "dependencies": {
    "@cordisjs/plugin-server": "1.7.0",
    "cordis": "4.0.0-rc.10",
    "sirv": "3.0.2",
    "@cordisjs/plugin-loader": "1.0.0-rc.7",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "js-yaml": "4.3.2",
    "zod": "4.6.5"
  },
  "bin": {
    "cordis-web": "bin/cordis-web.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1"
  }
}
