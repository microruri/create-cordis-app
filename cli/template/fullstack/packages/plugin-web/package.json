{
  "name": "@acme/plugin-web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rolldown -c ../../rolldown.config.ts --configLoader native"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./src/build.ts",
      "development": "./src/build.ts",
      "default": "./dist/build.js"
    },
    "./types": {
      "types": "./client/types.ts"
    }
  },
  "dependencies": {
    "@cordisjs/plugin-server": "catalog:",
    "cordis": "catalog:",
    "sirv": "3.0.2",
    "@cordisjs/plugin-loader": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "js-yaml": "4.3.2",
    "zod": "4.6.5"
  },
  "bin": {
    "cordis-web": "bin/cordis-web.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "daisyui": "5.7.46"
  }
}
