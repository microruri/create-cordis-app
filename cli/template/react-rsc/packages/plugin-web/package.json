{
  "name": "@acme/plugin-web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rolldown -c ../../rolldown.config.ts --configLoader native"
  },
  "exports": {
    "./client": "./web/client.ts",
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./src/build.ts",
      "development": "./src/build.ts",
      "default": "./dist/build.js"
    },
    "./types": {
      "types": "./src/types.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "cordis-web": "bin/cordis-web.mjs"
  },
  "dependencies": {
    "@acme/plugin-rpc": "workspace:*",
    "@cordisjs/plugin-server": "catalog:",
    "@cordisjs/plugin-loader": "catalog:",
    "cordis": "catalog:",
    "sirv": "3.0.2",
    "js-yaml": "4.3.2",
    "@tanstack/react-query": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "daisyui": "5.7.46",
    "@vitejs/plugin-rsc": "0.5.35",
    "rsc-html-stream": "0.0.8"
  }
}
