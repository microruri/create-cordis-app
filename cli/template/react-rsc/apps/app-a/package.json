{
  "name": "@acme/app-a",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "rolldown -c ../../rolldown.config.ts --configLoader native && cordis-web build",
    "dev": "node --expose-internals --conditions=development src/index.ts --dev",
    "start": "node dist/index.js"
  },
  "database": {
    "migrations": "@acme/app-database/migrations"
  },
  "dependencies": {
    "@acme/plugin-hello-a": "workspace:*",
    "@acme/runtime": "workspace:*",
    "@cordisjs/plugin-env": "catalog:",
    "@cordisjs/plugin-group": "catalog:",
    "@cordisjs/plugin-include": "catalog:",
    "@cordisjs/plugin-logger-console": "catalog:",
    "@cordisjs/plugin-server": "catalog:",
    "cordis": "catalog:",
    "@acme/plugin-rpc": "workspace:*",
    "@acme/plugin-web": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@acme/plugin-database": "workspace:*",
    "@acme/plugin-todos": "workspace:*",
    "@acme/app-database": "workspace:*"
  },
  "devDependencies": {
    "@cordisjs/plugin-hmr": "catalog:",
    "@cordisjs/plugin-timer": "catalog:"
  },
  "private": true
}
