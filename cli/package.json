{
  "name": "create-cordis-app",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "create-cordis-app": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs --configLoader native",
    "dev": "pnpm run build --watch",
    "start": "node dist/index.js",
    "lint": "oxlint src tests rolldown.config.mjs --deny-warnings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "pretest": "pnpm run build",
    "test": "node --expose-internals --conditions=development --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "oxlint": "^1.85.0",
    "rolldown": "^1.2.9",
    "typescript": "^7.0.2"
  }
}
