{
  "name": "create-cordis-app",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "create-cordis-app": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rolldown src/index.ts --file dist/index.js --format esm --platform node",
    "dev": "pnpm run build --watch",
    "start": "node dist/index.js",
    "lint": "oxlint src --deny-warnings",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "oxlint": "^1.85.0",
    "rolldown": "^1.2.9",
    "typescript": "^7.0.2"
  }
}
